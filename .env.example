# Optional shared fallback. Users can save private connections in Settings > Models.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
PORT=3210
BIND_ADDRESS=0.0.0.0

# Optional material directory; upload PPTX files through the app if left empty.
LIBRARY_PATH=

# Empty values use data/hermes-agent and data/hermes-runtime within this project.
HERMES_SOURCE_PATH=
HERMES_PYTHON=
HERMES_CONCURRENCY=4

# Optional parent for account-owned project folders.
PROJECTS_ROOT=
