    "imapflow": "^2.10.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.11.0",
    "multer": "^2.0.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.3.1",
    "pdf-parse": "^2.4.5",
